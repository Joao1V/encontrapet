{
   "name": "encontrapet",
   "version": "1.0.0",
   "private": true,
   "type": "module",
   "packageManager": "pnpm@10.19.0",
   "scripts": {
      "dev": "turbo run dev",
      "dev:backend": "turbo run dev --filter=backend",
      "dev:frontend": "turbo run dev --filter=frontend",
      "build": "turbo run build",
      "build:backend": "turbo run build --filter=backend",
      "build:frontend": "turbo run build --filter=frontend",
      "start": "turbo run start",
      "check-types": "turbo run check-types",
      "lint": "turbo run lint",
      "format": "turbo run format",
      "test": "turbo run test",
      "test:e2e": "turbo run test:e2e",
      "test:int": "turbo run test:int",
      "check": "biome check --write .",
      "clean": "pnpm clean:cache && pnpm clean:deps",
      "clean:cache": "rm -rf apps/*/.next apps/*/.turbo .turbo node_modules/.cache",
      "clean:deps": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
      "clean:all": "pnpm clean && pnpm install"
   },
   "devDependencies": {
      "@biomejs/biome": "^2.2.7",
      "turbo": "^2.6.0"
   },
   "pnpm": {
      "onlyBuiltDependencies": [
         "sharp",
         "esbuild",
         "unrs-resolver"
      ]
   }
}
